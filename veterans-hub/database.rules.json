{
  "rules": {
    ".read": false,
    ".write": false,
    "leads": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "!data.exists() || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['serviceId','name','contact','createdAt','consent']) && newData.child('consent').val() === true"
      }
    },
    "submissions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "!data.exists() || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['name','category','description','createdAt'])"
      }
    },
    "approved": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "admins": {
      ".read": false,
      ".write": false
    }
  }
}
