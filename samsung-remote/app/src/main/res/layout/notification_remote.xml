<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/q_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:layout_marginBottom="2dp"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:layoutDirection="ltr">
        <ImageButton android:id="@+id/q_power" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
            android:layout_margin="3dp" android:background="@drawable/quick_btn_bg" android:src="@drawable/ic_q_power" android:contentDescription="הפעלה" />
        <ImageButton android:id="@+id/q_voldown" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
            android:layout_margin="3dp" android:background="@drawable/quick_btn_bg" android:src="@drawable/ic_q_voldown" android:contentDescription="הנמך" />
        <ImageButton android:id="@+id/q_mute" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
            android:layout_margin="3dp" android:background="@drawable/quick_btn_bg" android:src="@drawable/ic_q_mute" android:contentDescription="השתק" />
        <ImageButton android:id="@+id/q_volup" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
            android:layout_margin="3dp" android:background="@drawable/quick_btn_bg" android:src="@drawable/ic_q_volup" android:contentDescription="הגבר" />
        <ImageButton android:id="@+id/q_playpause" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
            android:layout_margin="3dp" android:background="@drawable/quick_btn_bg" android:src="@drawable/ic_q_playpause" android:contentDescription="נגן או השהה" />
    </LinearLayout>
</LinearLayout>
